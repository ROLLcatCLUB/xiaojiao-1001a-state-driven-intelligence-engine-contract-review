      "purpose": [
        "priority",
        "suggestion_trigger",
        "view_composition",
        "gap_reasoning",
        "reminder_timing"
      ],
      "token_cost": "0_or_extremely_low"
    },
    {
      "layer": "llm",
      "purpose": [
        "content_generation",
        "complex_revision",
        "open_question_answering",
        "preference_summarization"
      ],
      "token_cost": "paid_model_cost"
    }
  ],
  "modules": [
    {
      "id": "intent_parser",
      "name": "Intent Parser",
      "input_sources": [
        "teacher_text",
        "teacher_click",
        "time_trigger",
        "work_object_event"
      ],
      "output": "structured_intent",
      "parsing_order": [
        "rule_matching",
        "lightweight_semantic_classification_or_embedding",
        "llm_escalation_only_when_low_confidence_or_open_ended"
      ],
      "required_intents": [
        "view_today",
        "view_week",
        "generate_plan",
        "prepare_lesson",
        "confirm_current",
        "revise_section",
        "generate_handout",
        "inspect_gap",
        "ask_open_question",
        "save_preference_candidate"
      ]
    },
    {
      "id": "work_state_manager",
      "name": "Work State Manager",
      "backend_core_asset": true,
      "owned_state_fields": [
        "teacher_profile",
        "temporal_state",
        "focus_state",
        "work_objects",
        "gaps",
        "pending_suggestions",
        "preference_profile",
        "work_log",
        "audit_trace"
      ],
      "reasoning_examples": [
        "teaching_work_plan.confirmed -> weekly_work_graph.available",
        "lesson_draft.pending_confirmation -> today_work_items.highlight_current_lesson",
        "textbook_catalog.missing -> draft_generation.allowed_with_progress_review_flag",
        "teacher_prefers_shorter_activities -> revision_suggestion.default_to_compact_rhythm"
      ],
      "raw_internal_state_label_exposure_allowed": false
    },
    {
      "id": "work_view_composer",
      "name": "Work View Composer",
      "llm_call_allowed": false,
      "responsibilities": [
        "choose_primary_work_object",
        "choose_visible_supporting_objects",
        "hide_irrelevant_internal_state",
        "attach_xiaojiao_hints_to_relevant_work_objects",
        "prevent_chat_history_from_becoming_primary_workspace"
      ],
      "output_shape": {
        "layout": "today_sequence",
        "primary": "today_work_items",
        "supporting": [
          "week_strip"
        ],
        "hidden": [
          "semester_plan"
        ],
        "agent_notes": [
          {
            "attach_to": "lesson_L003",
            "source": "structured_suggestion",
            "actions": [
              "现在查看草稿",
              "稍后处理"
            ]
          }
        ]
      }
    },
    {
      "id": "suggestion_engine",
      "name": "Suggestion Engine",
      "default_mode": "structured_suggestion",
      "structured_formula": "template + data + correct_timing + correct_attachment_point",
      "llm_suggestion_allowed_only_when": [
        "content_understanding_required",
        "complex_judgment_required",
        "language_synthesis_beyond_template_required"
      ],
      "most_suggestions_zero_token": true
    },
    {
      "id": "generation_pipeline",
      "name": "Generation Pipeline",
      "llm_allowed_for": [
        "generate_teaching_work_plan_content",
        "generate_lesson_design",
        "generate_handout",
        "generate_evaluation_rubric",
        "revise_complex_content",
        "answer_open_ended_professional_question",
        "summarize_preference_candidates"
      ],
      "context_trimming_required": true,
      "full_work_state_prompt_allowed": false,
      "full_chat_history_context_allowed": false,
      "structured_output_required": true,
      "pipeline": [
        "LLM output",
        "structured parse",
        "policy gate",
        "Work State candidate update",
        "Composer projection"
      ]
    },
    {
      "id": "preference_learner",
      "name": "Preference Learner",
      "stage_mode": "candidate_only_readonly",
      "allowed_outputs": [
        "preference_candidate",
        "teacher_profile_candidate",
        "readonly_preference_summary",
        "confirmation_required_before_promotion"
      ],
      "real_memory_write_allowed": false,
      "silent_preference_promotion_allowed": false,
      "candidate_examples": [
        "teacher_often_shortens_activity_sections",
        "teacher_prefers_fewer_stronger_tasks",
        "teacher_simplifies_handouts",
        "teacher_prefers_specific_evaluation_language",
        "teacher_keeps_certain_lesson_structure"
      ]
    },
    {
      "id": "observation_metrics",
      "name": "Observation Metrics",
      "required_metrics": [
        "fallback_rate",
        "suggestion_acceptance_rate",
        "draft_acceptance_rate",
        "average_revision_rounds",
        "direct_confirmation_ratio_after_generation",
        "teacher_dwell_longest_step",
        "unknown_intent_top_list",
        "ignored_suggestion_top_list",
        "skipped_work_object_top_list",
        "llm_call_rate_by_intent",
        "token_cost_by_work_object"
